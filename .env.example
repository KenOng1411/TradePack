# Public site URL used for canonical URLs, hreflang, sitemap, and Open Graph tags.
# TODO(owner): replace with the real production domain once purchased/confirmed.
PUBLIC_SITE_URL=https://tradepack.local

# Gemini API key, used only by `npm run gen:brand` (scripts/generate-brand-assets.ts).
# Not required for `npm run dev` or `npm run build`. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# TODO(owner): Google Search Console HTML-tag verification code, once you register the real domain.
# Not wired into any page yet — add a <meta name="google-site-verification" content="..." /> in
# src/components/Seo.astro when you have a real value.
# GOOGLE_SITE_VERIFICATION=
