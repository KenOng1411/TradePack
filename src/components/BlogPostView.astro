---
import BaseLayout from "../layouts/BaseLayout.astro";
import RiskDisclaimer from "./RiskDisclaimer.astro";
import { PAGE_KEYS, navTargetUrl, getBlogPageId } from "../i18n/routes";
import { SITE_NAME } from "../lib/site";
import { render, type CollectionEntry } from "astro:content";
import type { Locale } from "../i18n/routes";

interface Props {
  locale: Locale;
  post: CollectionEntry<"blog">;
}

const { locale, post } = Astro.props;
const { Content } = await render(post);

const slug = post.id.replace(new RegExp(`^${locale}/`), "");
const pageKey = getBlogPageId(locale, slug);

const dateOptions: Intl.DateTimeFormatOptions = { year: "numeric", month: "long", day: "numeric" };

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  inLanguage: locale,
  author: { "@type": "Organization", name: post.data.author },
  publisher: { "@type": "Organization", name: SITE_NAME },
};
---

<BaseLayout
  locale={locale}
  pageKey={pageKey}
  title={post.data.title}
  description={post.data.description}
  type="article"
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <a href={navTargetUrl(locale, PAGE_KEYS.blogIndex)} class="text-sm font-medium text-[var(--color-accent)] hover:underline">
      ← <slot name="back-label">All posts</slot>
    </a>
    <h1 class="text-balance mt-4 text-3xl font-extrabold sm:text-4xl">{post.data.title}</h1>
    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[var(--color-muted)]">
      <span>{post.data.author}</span>
      <span aria-hidden="true">·</span>
      <time datetime={post.data.publishDate.toISOString()}>
        {post.data.publishDate.toLocaleDateString(locale, dateOptions)}
      </time>
    </div>

    <div class="prose-content mt-8 max-w-none text-[var(--color-text)]">
      <Content />
    </div>

    <div class="mt-12">
      <RiskDisclaimer locale={locale} variant="page" />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .prose-content h2 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .prose-content p {
    margin-bottom: 1.1rem;
    line-height: 1.75;
    color: var(--color-muted);
  }
  .prose-content ul,
  .prose-content ol {
    margin: 1.1rem 0 1.1rem 1.25rem;
    color: var(--color-muted);
    line-height: 1.75;
  }
  .prose-content li {
    margin-bottom: 0.4rem;
  }
  .prose-content ol {
    list-style: decimal;
  }
  .prose-content ul {
    list-style: disc;
  }
  .prose-content a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-content table {
    display: block;
    overflow-x: auto;
    width: 100%;
    margin: 1.1rem 0 1.5rem;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .prose-content th,
  .prose-content td {
    padding: 0.65rem 0.9rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }
  .prose-content th {
    color: var(--color-text);
    font-weight: 600;
    background-color: var(--color-surface);
  }
  .prose-content td {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .prose-content strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .prose-content img {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.5rem 0;
    border-radius: 1rem;
    border: 1px solid var(--color-border);
  }
  .prose-content blockquote {
    margin: 1.1rem 0 1.5rem;
    padding: 0.9rem 1.1rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-warning-soft);
    background-color: var(--color-warning-soft);
    color: var(--color-muted);
  }
  .prose-content blockquote p {
    margin-bottom: 0;
  }
</style>
