---
interface Props {
  value: string;
  label: string;
  accent?: "green" | "violet";
}

const { value, label, accent = "green" } = Astro.props;

const accentClass = accent === "violet" ? "text-[var(--color-violet)]" : "text-[var(--color-accent)]";
---

<div class="flex flex-col gap-1 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] px-5 py-4 min-w-[9.5rem]">
  <span class={`text-2xl font-bold tabular-nums sm:text-3xl ${accentClass}`}>{value}</span>
  <span class="text-xs text-[var(--color-muted)] sm:text-sm">{label}</span>
</div>
