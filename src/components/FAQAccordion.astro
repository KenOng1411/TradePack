---
import Icon from "./Icon.astro";

export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  class?: string;
}

const { items, class: className = "" } = Astro.props;
---

<div class={`flex flex-col gap-3 ${className}`}>
  {
    items.map((item, i) => (
      <details
        class="group rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] open:border-[var(--color-accent)]/40"
        name={`faq-${i}`}
      >
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-sm font-semibold text-[var(--color-text)] sm:text-base [&::-webkit-details-marker]:hidden">
          <span>{item.question}</span>
          <Icon
            name="chevron-down"
            class="size-5 shrink-0 text-[var(--color-muted)] transition-transform duration-200 group-open:rotate-180 group-open:text-[var(--color-accent)]"
          />
        </summary>
        <div class="px-5 pb-5 text-sm leading-relaxed text-[var(--color-muted)] sm:text-base">
          {item.answer}
        </div>
      </details>
    ))
  }
</div>
