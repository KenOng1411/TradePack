---
interface Props {
  name:
    | "chevron-down"
    | "shield-check"
    | "check-circle"
    | "globe"
    | "menu"
    | "close"
    | "arrow-right"
    | "external-link"
    | "spark"
    | "chart"
    | "wallet";
  class?: string;
}

const { name, class: className = "size-5" } = Astro.props;

const paths: Record<Props["name"], string> = {
  "chevron-down": "M6 9l6 6 6-6",
  "shield-check": "M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3zM9 12l2 2 4-4",
  "check-circle": "M12 3a9 9 0 100 18 9 9 0 000-18zM8.5 12l2.5 2.5 4.5-5",
  globe: "M12 3a9 9 0 100 18 9 9 0 000-18zM3 12h18M12 3c2.5 2.5 4 5.5 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.5-4-9s1.5-6.5 4-9z",
  menu: "M4 7h16M4 12h16M4 17h16",
  close: "M6 6l12 12M18 6L6 18",
  "arrow-right": "M5 12h14M13 6l6 6-6 6",
  "external-link": "M14 5h5v5M19 5l-9 9M7 5H6a1 1 0 00-1 1v12a1 1 0 001 1h12a1 1 0 001-1v-1",
  spark: "M12 2l1.8 5.6L19 9l-5.2 1.6L12 16l-1.8-5.4L5 9l5.2-1.4L12 2z",
  chart: "M4 20V10M10 20V4M16 20v-7M22 20H2",
  wallet: "M3 7a2 2 0 012-2h13a1 1 0 011 1v2M3 7v10a2 2 0 002 2h14a2 2 0 002-2v-8a1 1 0 00-1-1h-4a2 2 0 100 4h4M3 7l4-4h9",
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d={paths[name]}></path>
</svg>
