---
import type { GetStaticPaths } from "astro";
import BlogPostView from "../../../components/BlogPostView.astro";
import { getCollection } from "astro:content";

export const getStaticPaths = (async () => {
  const posts = await getCollection("blog", (e) => e.data.locale === "vi");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^vi\//, "") },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
---

<BlogPostView locale="vi" post={post}>
  <Fragment slot="back-label">Tất cả bài viết</Fragment>
</BlogPostView>
