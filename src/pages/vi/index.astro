---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import Card from "../../components/Card.astro";
import TrustBar from "../../components/TrustBar.astro";
import Icon from "../../components/Icon.astro";
import AppScreenshot from "../../components/AppScreenshot.astro";
import leaderboardScreenshot from "../../assets/screenshots/mobile-leaderboard-clans.jpg";
import { PAGE_KEYS, resolveLocaleUrl } from "../../i18n/routes";
import { FOMO, SITE_NAME } from "../../lib/site";
import { getCollection } from "astro:content";

const locale = "vi" as const;
const pageKey = PAGE_KEYS.home;

const posts = (await getCollection("blog", (e) => e.data.locale === locale))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const howItWorks = [
  { title: "Tải app Fomo", body: `Có trên ${FOMO.platforms.join(", ")}.` },
  { title: "Nhập mã giới thiệu", body: "Khi đăng ký (nếu muốn dùng)." },
  { title: "Giao dịch bình thường", body: `Mức giảm ${FOMO.feeDiscountPercent}% phí áp dụng tự động cho mọi lệnh.` },
];
---

<BaseLayout
  locale={locale}
  pageKey={pageKey}
  title={`${SITE_NAME} — Đánh giá độc lập về Fomo & hướng dẫn mã giới thiệu`}
  description="Đánh giá độc lập về ứng dụng trading crypto &quot;social&quot; Fomo — kèm mã giới thiệu giảm 10% phí giao dịch nếu bạn quyết định dùng thử."
>
  <section class="mx-auto max-w-6xl px-4 pb-16 pt-14 sm:px-6 sm:pt-20">
    <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1 text-xs font-medium text-[var(--color-muted)]">
      <Icon name="shield-check" class="size-3.5 text-[var(--color-accent)]" />
      Trang đánh giá độc lập — không thuộc Fomo
    </span>
    <h1 class="text-balance mt-5 max-w-2xl text-4xl font-extrabold leading-tight sm:text-5xl">
      Tìm hiểu <span class="text-[var(--color-accent)]">Fomo</span> trước khi giao dịch
    </h1>
    <p class="mt-5 max-w-xl text-base leading-relaxed text-[var(--color-muted)] sm:text-lg">
      Đánh giá độc lập về ứng dụng trading crypto "social" Fomo — kèm mã giới thiệu giảm {FOMO.feeDiscountPercent}%
      phí giao dịch nếu bạn quyết định dùng thử.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button href={resolveLocaleUrl(locale, PAGE_KEYS.referralCode)} size="lg" showArrow>
        Xem mã giới thiệu
      </Button>
    </div>
    <p class="mt-4 text-xs text-[var(--color-muted)]">TradePack là trang đánh giá độc lập, không thuộc Fomo.</p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <TrustBar
      items={[
        { icon: "wallet", text: "Series B $75 triệu do Index Ventures dẫn đầu (2026)" },
        { icon: "spark", text: "Có Union Square Ventures, Benchmark tham gia" },
        { icon: "shield-check", text: "Non-custodial — bạn tự giữ tài sản, không phải Fomo giữ hộ" },
        { icon: "chart", text: "SEC/CFTC (Mỹ) đã làm rõ khung pháp lý tháng 3/2026" },
      ]}
    />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <h2 class="text-2xl font-bold sm:text-3xl">Cách hoạt động</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-3">
      {
        howItWorks.map((step, i) => (
          <Card class="text-center">
            <span class="mx-auto flex size-9 items-center justify-center rounded-full bg-[var(--color-accent)] text-sm font-bold text-[var(--color-bg)]">
              {i + 1}
            </span>
            <h3 class="mt-4 text-base font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{step.body}</p>
          </Card>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-16 sm:px-6">
    <Card>
      <h2 class="text-xl font-bold sm:text-2xl">Vì sao có trang này</h2>
      <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)] sm:text-base">
        Fomo là ứng dụng trading non-custodial — nghĩa là tài sản của bạn nằm trong ví do chính bạn kiểm soát, không
        phải tài khoản do công ty giữ hộ. Fomo chạy trên nhiều chain ({FOMO.chains.join(", ")}), hỗ trợ giao dịch spot
        (memecoin, altcoin, stablecoin) và perpetuals qua {FOMO.perpsProvider} (không áp dụng cho người dùng tại Mỹ).
        TradePack ra đời để giải thích rõ cách nó hoạt động, chi phí thực tế, và cả những điểm chưa hoàn hảo — không
        chỉ để giới thiệu suông.
      </p>
      <p class="mt-4 text-xs italic text-[var(--color-muted)]">
        Lưu ý: nội dung trên trang này mang tính thông tin/đánh giá, không phải lời mời đầu tư hay khuyến nghị tài
        chính.
      </p>
    </Card>
  </section>

  <section class="mx-auto max-w-xs px-4 pb-16 sm:px-6">
    <AppScreenshot
      src={leaderboardScreenshot}
      alt="Tab Bảng xếp hạng và Clans của Fomo, hiển thị top trader và thứ hạng clan cùng biểu đồ giao dịch"
      caption="Tab Bảng xếp hạng và Clans của Fomo — lớp tương tác xã hội, cạnh tranh ở trung tâm ứng dụng."
    />
  </section>

  {
    posts.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
        <div class="flex items-center justify-between">
          <h2 class="text-2xl font-bold sm:text-3xl">Từ blog</h2>
          <a href={resolveLocaleUrl(locale, PAGE_KEYS.blogIndex)} class="text-sm font-semibold text-[var(--color-accent)] hover:underline">
            Xem tất cả
          </a>
        </div>
        <div class="mt-6 grid gap-5 sm:grid-cols-3">
          {posts.map((post) => (
            <a href={`/vi/blog/${post.id.replace(/^vi\//, "")}`} class="block">
              <Card class="h-full transition-colors hover:border-[var(--color-accent)]/40">
                <p class="text-xs text-[var(--color-muted)]">
                  {post.data.publishDate.toLocaleDateString("vi-VN", { year: "numeric", month: "long", day: "numeric" })}
                </p>
                <h3 class="mt-2 text-lg font-semibold leading-snug">{post.data.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)] line-clamp-3">{post.data.description}</p>
              </Card>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
