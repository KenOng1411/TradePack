---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import Card from "../../components/Card.astro";
import StatBadge from "../../components/StatBadge.astro";
import RiskDisclaimer from "../../components/RiskDisclaimer.astro";
import AppScreenshot from "../../components/AppScreenshot.astro";
import { PAGE_KEYS, resolveLocaleUrl } from "../../i18n/routes";
import { FOMO, SITE_NAME } from "../../lib/site";
import tradingChartScreenshot from "../../assets/screenshots/trading-chart-feed.jpg";
import mobilePortfolioScreenshot from "../../assets/screenshots/mobile-portfolio-home.jpg";
import mobileFeedGlobalScreenshot from "../../assets/screenshots/mobile-feed-global.jpg";
import mobileFeedFriendsScreenshot from "../../assets/screenshots/mobile-feed-friends.jpg";

const locale = "ko" as const;
const pageKey = PAGE_KEYS.review;

const toc = [
  { id: "fomo-ran", label: "Fomo란?" },
  { id: "georae-ganeung", label: "거래 가능한 자산" },
  { id: "susuryo", label: "수수료" },
  { id: "anjeonhan-ga", label: "Fomo는 안전한가?" },
  { id: "jangjeom", label: "장점" },
  { id: "juuihal-jeom", label: "주의할 점" },
  { id: "gyeollon", label: "결론" },
];

const pros = [
  "앱을 열고 실제 거래까지 이어지는 속도가 매우 빠릅니다 — 다른 앱에서 흔한 온보딩 장벽이 거의 없습니다.",
  "단순한 마케팅 문구가 아닌, 실제 법적 명확성을 갖춘 논커스터디얼 구조입니다.",
  "하나의 인터페이스에서 멀티체인(Solana, Base, BNB Chain, Monad)을 지원합니다.",
];

const cons = [
  "예치금 보호 장치가 없습니다 — 셀프 커스터디 구조상 지갑 접근을 잃으면 복구 수단이 없습니다.",
  "유동성이 낮은 토큰의 경우 매수는 쉽지만 매도가 어렵다는 이용자 후기가 있습니다.",
  "소셜 피드와 리더보드 형식이 빠른 행동을 유도하도록 설계되어 있어, 충동적으로 거래하기 쉬운 성향이라면 주의가 필요합니다 — 밈코인 포지션은 가치가 0이 될 수 있습니다.",
  "수수료 구조가 처음에는 명확히 드러나지 않습니다 — 실제 수치는 수수료 페이지를 참고하세요.",
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Review",
  itemReviewed: {
    "@type": "SoftwareApplication",
    name: FOMO.displayName,
    applicationCategory: "FinanceApplication",
    url: FOMO.website,
  },
  author: { "@type": "Organization", name: SITE_NAME },
  publisher: { "@type": "Organization", name: SITE_NAME },
  reviewBody:
    "Fomo에 대한 독립적인 리뷰입니다. 이 페이지는 Fomo의 공식 페이지가 아니며 TradePack은 Fomo를 대리, 승인하지 않습니다.",
  datePublished: "2026-12-08",
  inLanguage: "ko",
};
---

<BaseLayout
  locale={locale}
  pageKey={pageKey}
  title="Fomo 앱 리뷰 2026: 수수료, 안전성, 실제 사용 경험"
  description="Solana, Base, BNB Chain, Monad에서 작동하는 논커스터디얼 소셜 트레이딩 앱 Fomo에 대한 독립적인 리뷰. 수수료, 안전성, 투자 유치 현황, 솔직한 장단점."
  type="article"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <span class="text-xs font-semibold uppercase tracking-wide text-[var(--color-accent)]">독립 리뷰</span>
    <h1 class="text-balance mt-2 text-3xl font-extrabold sm:text-4xl">{SITE_NAME}의 Fomo 리뷰</h1>
    <p class="mt-4 max-w-2xl text-[var(--color-muted)]">
      {SITE_NAME}은 Fomo를 대리, 승인하지 않습니다. 이 리뷰는 저희 자체 조사를 바탕으로 하며 추천 링크를 통해 수수료를
      받을 수 있습니다.
    </p>

    <div class="mt-10 grid gap-10 lg:grid-cols-[240px_1fr]">
      <aside class="hidden lg:block">
        <nav class="sticky top-24 flex flex-col gap-1 border-l border-[var(--color-border)] pl-4" aria-label="목차">
          {
            toc.map((item) => (
              <a href={`#${item.id}`} class="py-1.5 text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)]">
                {item.label}
              </a>
            ))
          }
        </nav>
      </aside>

      <div class="prose-content max-w-none">
        <p>
          Fomo는 밈코인, 알트코인, 스테이블코인, 그리고 (미국 외 지역에서) 무기한 선물까지 거래할 수 있는 "소셜
          우선" 크립토 트레이딩 앱입니다 — 모두 사용자가 직접 관리하는 논커스터디얼 지갑을 통해 이루어집니다. 배경에는
          상당한 자본이 있습니다: {FOMO.leadInvestor}가 주도한 {FOMO.fundingRound} 투자를 {FOMO.valuation}{" "}
          밸류에이션으로 유치했으며, {FOMO.otherInvestors.join(", ")}도 참여해 공개된 총 투자금은 약{" "}
          {FOMO.totalFundingDisclosed}에 달합니다. 이 리뷰에서는 실제 작동 방식, 비용, 그리고 부족한 점을 다룹니다.
        </p>

        <div class="not-prose my-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
          <StatBadge value={`${FOMO.spotFeePercent}%`} label="스팟 수수료" />
          <StatBadge value={`${FOMO.feeDiscountPercent}%`} label="추천 코드 할인" accent="violet" />
          <StatBadge value={FOMO.chains.length.toString()} label="지원 체인" />
          <StatBadge value={FOMO.valuation} label="밸류에이션" accent="violet" />
        </div>

        <div class="not-prose my-8 flex flex-wrap items-start gap-5">
          <AppScreenshot
            src={tradingChartScreenshot}
            alt="실시간 가격 차트, 매수/매도 패널, 매수/매도 거래량 통계가 표시된 Fomo의 메인 거래 화면"
            caption="Fomo의 메인 거래 화면: 실시간 가격 차트, 매수/매도 패널, 피드 기반 통계."
            class="min-w-0 flex-1 basis-80"
          />
          <AppScreenshot
            src={mobilePortfolioScreenshot}
            alt="$0 잔액, Deposit 버튼, Weekly Top Trades, BTC·ETH·XRP 등 토큰 목록이 표시된 Fomo의 모바일 홈 화면"
            caption="실제 모바일 홈 화면 — 대부분의 사용자는 데스크톱 화면을 본 적이 없습니다."
            class="w-[220px] shrink-0"
          />
        </div>

        <section id="fomo-ran" class="scroll-mt-24">
          <h2>Fomo란?</h2>
          <p>
            Fomo는 전통적인 거래소 인터페이스보다는 소셜 트레이딩 앱을 표방합니다 — 피드, 리더보드, 빠른 "탐색 후
            거래" 흐름이 핵심입니다. 기술적으로는 논커스터디얼입니다: {FOMO.custodyMechanism} 자산은 회사가 아닌
            본인만 접근 가능한 지갑에 보관됩니다.
          </p>
        </section>

        <section id="georae-ganeung" class="scroll-mt-24">
          <h2>거래 가능한 자산</h2>
          <p>
            스팟 시장 — 밈코인, 알트코인, 스테이블코인 — Solana(주요 체인), Base, BNB Chain, Monad에서 거래
            가능합니다. 무기한 선물은 {FOMO.perpsProvider}와의 연동을 통해 제공되지만,{" "}
            <strong>미국 사용자는 이용할 수 없습니다</strong> — Fomo는 미국 내 레버리지 파생상품 제공에 필요한 국내
            등록을 아직 완료하지 않았습니다. 다만 핵심 스팟 거래는 미국 전역에서 합법적으로 이용 가능합니다.
          </p>
        </section>

        <section id="susuryo" class="scroll-mt-24">
          <h2>수수료</h2>
          <p>
            스팟 거래는 할인 전 기준 거래당 약 {FOMO.spotFeePercent}%입니다. 무기한 선물은 기초 거래소({FOMO.perpsProvider})
            수수료 위에 사이드당 약 {FOMO.perpsFeePerSidePercent}%가 추가로 붙습니다. 자세한 계산 예시는{" "}
            <a href={resolveLocaleUrl(locale, PAGE_KEYS.fees)}>수수료 상세 페이지</a>를 참고하세요.
          </p>
        </section>

        <section id="anjeonhan-ga" class="scroll-mt-24">
          <h2>Fomo는 안전한가?</h2>
          <p>
            여기서 두 가지 별개의 질문을 구분해야 합니다. 기술적으로: 논커스터디얼 앱이므로 Fomo가 일방적으로 자산을
            이동하거나 동결할 수 없습니다 — 이는 한 종류의 리스크(거래소 파산으로 인한 예치금 손실)를 제거하지만,
            다른 리스크(지갑 접근 권한을 잃거나 밈코인이 0으로 폭락할 경우 회사 차원의 안전망이 없음)를 더합니다.
            법적으로: 2026년 3월 SEC와 CFTC(미국)가 공동으로 Fomo 같은 논커스터디얼 지갑 인터페이스가 브로커-딜러
            등록이 필요 없다는 점을 명확히 했으며, "Covered User Interface Provider"라는 별도 면제 범주를
            신설했습니다.
          </p>
        </section>

        <section id="jangjeom" class="scroll-mt-24">
          <h2>장점</h2>
          <ul>
            {pros.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section id="juuihal-jeom" class="scroll-mt-24">
          <h2>주의할 점</h2>
          <ul>
            {cons.map((item) => <li>{item}</li>)}
          </ul>
          <div class="not-prose mt-2 grid max-w-md grid-cols-2 gap-4">
            <AppScreenshot
              src={mobileFeedGlobalScreenshot}
              alt="다른 사용자의 매수/매도 주문이 몇 초 전에 올라온 Fomo의 Global 피드"
              caption="Global 피드 — 다른 사용자의 거래가 몇 초 단위로 실시간 업데이트됩니다."
            />
            <AppScreenshot
              src={mobileFeedFriendsScreenshot}
              alt="팔로우 중인 트레이더들의 매수/매도 활동을 그룹으로 보여주는 Fomo의 Friends 피드"
              caption="Friends 피드 — 팔로우한 트레이더들의 활동을 모아 보여줍니다."
            />
          </div>
        </section>

        <section id="gyeollon" class="scroll-mt-24">
          <h2>결론</h2>
          <p>
            Fomo는 실제 투자 유치와 실질적인 논커스터디얼 구조를 갖춘, 이 분야에서 법적 명확성이 비교적 뚜렷한
            서비스입니다 — "혹시 사기 아닐까"라고 물어야 할 종류는 아닙니다. 남은 리스크는 Fomo만의 문제가 아니라
            밈코인·무기한 선물 거래 전반에 내재된 리스크입니다. 더 알아보고 싶다면{" "}
            <a href={resolveLocaleUrl(locale, PAGE_KEYS.referralCode)}>추천 코드 페이지</a>에서 수수료 할인 정보를
            확인하세요.
          </p>
        </section>

        <div class="not-prose mt-10">
          <Card class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-semibold">할인이 적용된 Fomo를 사용해보시겠어요?</p>
              <p class="mt-1 text-sm text-[var(--color-muted)]">코드 {FOMO.referralCode}로 {FOMO.feeDiscountPercent}% 할인.</p>
            </div>
            <Button href={resolveLocaleUrl(locale, PAGE_KEYS.referralCode)} showArrow class="w-full sm:w-auto">
              추천 코드 보기
            </Button>
          </Card>
        </div>

        <div class="not-prose mt-8">
          <RiskDisclaimer locale={locale} variant="page" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .prose-content h2 {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .prose-content p {
    margin-bottom: 1.1rem;
    line-height: 1.75;
    color: var(--color-muted);
  }
  .prose-content ul {
    margin: 0 0 1.1rem 1.25rem;
    list-style: disc;
    color: var(--color-muted);
    line-height: 1.75;
  }
  .prose-content li {
    margin-bottom: 0.5rem;
  }
  .prose-content a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
