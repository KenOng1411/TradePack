---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Card from "../../../components/Card.astro";
import Button from "../../../components/Button.astro";
import { PAGE_KEYS } from "../../../i18n/routes";
import { SITE_NAME } from "../../../lib/site";
import { getCollection } from "astro:content";

const locale = "ko" as const;
const pageKey = PAGE_KEYS.blogIndex;

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("blog", (e) => e.data.locale === "ko")).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
  );
  return paginate(posts, { pageSize: 6 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const allTags = [...new Set(page.data.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout
  locale={locale}
  pageKey={pageKey}
  title="블로그"
  description={`Fomo, 논커스터디얼 트레이딩, 추천 코드 절약에 대한 가이드와 분석을 ${SITE_NAME} 팀이 전해드립니다.`}
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <h1 class="text-3xl font-extrabold sm:text-4xl">블로그</h1>
    <p class="mt-3 max-w-2xl text-[var(--color-muted)]">
      Fomo를 자신 있게 거래할 수 있도록 돕는 가이드, 수수료 분석, 비교 콘텐츠입니다.
    </p>

    {
      allTags.length > 0 && (
        <div id="tag-filters" class="mt-6 flex flex-wrap gap-2" role="group" aria-label="태그로 필터링">
          <button
            type="button"
            data-tag="all"
            class="tag-filter-btn rounded-full border border-[var(--color-accent)] bg-[var(--color-accent-soft)] px-4 py-1.5 text-sm font-medium text-[var(--color-accent)]"
            aria-pressed="true"
          >
            전체
          </button>
          {allTags.map((tag) => (
            <button
              type="button"
              data-tag={tag}
              class="tag-filter-btn rounded-full border border-[var(--color-border)] px-4 py-1.5 text-sm font-medium text-[var(--color-muted)] hover:border-[var(--color-accent)]"
              aria-pressed="false"
            >
              {tag}
            </button>
          ))}
        </div>
      )
    }

    <div id="post-grid" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        page.data.map((post) => {
          const slug = post.id.replace(/^ko\//, "");
          return (
            <a href={`/ko/blog/${slug}`} class="post-card block" data-tags={post.data.tags.join(",")}>
              <Card class="h-full transition-colors hover:border-[var(--color-accent)]/40">
                <p class="text-xs text-[var(--color-muted)]">
                  {post.data.publishDate.toLocaleDateString("ko-KR", { year: "numeric", month: "long", day: "numeric" })}
                </p>
                <h2 class="mt-2 text-lg font-semibold leading-snug">{post.data.title}</h2>
                <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)] line-clamp-3">{post.data.description}</p>
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {post.data.tags.map((tag) => (
                    <span class="rounded-full bg-[var(--color-bg)] px-2.5 py-1 text-[11px] text-[var(--color-muted)]">{tag}</span>
                  ))}
                </div>
              </Card>
            </a>
          );
        })
      }
    </div>

    <p id="no-results" hidden class="mt-8 text-sm text-[var(--color-muted)]">
      해당 태그와 일치하는 글이 없습니다.
    </p>

    {
      (page.url.prev || page.url.next) && (
        <nav class="mt-10 flex items-center justify-between" aria-label="블로그 페이지 네비게이션">
          {page.url.prev ? (
            <Button href={page.url.prev} variant="secondary">
              최신 글
            </Button>
          ) : (
            <span />
          )}
          {page.url.next && (
            <Button href={page.url.next} variant="secondary">
              이전 글
            </Button>
          )}
        </nav>
      )
    }
  </section>
</BaseLayout>

<script>
  function initTagFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".tag-filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".post-card");
    const noResults = document.getElementById("no-results");
    if (!buttons.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const tag = btn.dataset.tag ?? "all";
        buttons.forEach((b) => {
          const active = b === btn;
          b.setAttribute("aria-pressed", String(active));
          b.classList.toggle("border-[var(--color-accent)]", active);
          b.classList.toggle("bg-[var(--color-accent-soft)]", active);
          b.classList.toggle("text-[var(--color-accent)]", active);
          b.classList.toggle("border-[var(--color-border)]", !active);
          b.classList.toggle("text-[var(--color-muted)]", !active);
        });

        let visibleCount = 0;
        cards.forEach((card) => {
          const tags = (card.dataset.tags ?? "").split(",");
          const show = tag === "all" || tags.includes(tag);
          card.hidden = !show;
          if (show) visibleCount++;
        });
        if (noResults) noResults.hidden = visibleCount !== 0;
      });
    });
  }

  initTagFilters();
  document.addEventListener("astro:after-swap", initTagFilters);
</script>
