---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import TrustBar from "../components/TrustBar.astro";
import FeeCalculator from "../components/FeeCalculator.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import RiskDisclaimer from "../components/RiskDisclaimer.astro";
import Icon from "../components/Icon.astro";
import AppScreenshot from "../components/AppScreenshot.astro";
import { PAGE_KEYS } from "../i18n/routes";
import { FOMO, SITE_NAME } from "../lib/site";
import referralEarningsScreenshot from "../assets/screenshots/referral-earnings.jpg";
import shareCardScreenshot from "../assets/screenshots/share-card-portfolio.png";

const locale = "en" as const;
const pageKey = PAGE_KEYS.referralCode;

const steps = [
  { title: "Apply the code", body: "Tap the button above or enter the code manually during Fomo signup." },
  { title: "Verify your account", body: "Same process either way, the code doesn't change onboarding." },
  { title: "Trade normally", body: "Your 10% fee discount is already applied." },
];

const faqItems = [
  {
    question: "Is this code official?",
    answer:
      "No — TradePack is an independent review site. The code is a standard Fomo referral code; it isn't a special TradePack-only discount, and Fomo doesn't endorse this site.",
  },
  {
    question: "Does it cost anything to use the code?",
    answer:
      "No. It's the standard way Fomo's referral program works — you get 10% off, we may earn a commission when you trade.",
  },
  {
    question: "Can I use it if I already have a Fomo account?",
    answer:
      "Referral codes generally only apply at signup — if you already have an account, applying a new code likely won't retroactively change your fees. Check Fomo's app for the current rules.",
  },
];
---

<BaseLayout
  locale={locale}
  pageKey={pageKey}
  title="Fomo Referral Code — 10% Off Trading Fees"
  description="Use TradePack's Fomo referral code to get 10% off trading fees on every trade, from day one."
  ogImage="/images/og-referral.png"
>
  <section class="mx-auto max-w-4xl px-4 pb-14 pt-14 text-center sm:px-6 sm:pt-20">
    <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1 text-xs font-medium text-[var(--color-muted)]">
      <Icon name="shield-check" class="size-3.5 text-[var(--color-accent)]" />
      TradePack is an independent review site — not affiliated with or endorsed by Fomo
    </span>
    <h1 class="text-balance mt-5 text-4xl font-extrabold leading-tight sm:text-5xl">
      Save <span class="text-[var(--color-accent)]">{FOMO.feeDiscountPercent}%</span> on every Fomo trade
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-[var(--color-muted)] sm:text-lg">
      Apply our referral code when you sign up — the discount applies automatically to your trading fees, no extra
      steps.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <Button href={FOMO.referralUrl} external size="lg" showArrow>
        Sign Up With {FOMO.feeDiscountPercent}% Off
      </Button>
    </div>
  </section>

  <section class="mx-auto flex max-w-2xl flex-wrap justify-center gap-5 px-4 pb-16 sm:px-6">
    <AppScreenshot
      src={referralEarningsScreenshot}
      alt="Fomo app Earnings screen showing 'Refer and earn 25% of your friends' fees' and a referral link"
      caption={`Referral earnings inside the real Fomo app — referrers earn ${FOMO.referrerEarningsPercent}% of their friends' trading fees.`}
      class="w-[280px]"
    />
    <AppScreenshot
      src={shareCardScreenshot}
      alt={`Fomo's own share card for the TradePack account, reading "10% off fees with code TradePack"`}
      caption="Generated by the Fomo app itself, not by us — proof the code is real."
      class="w-[280px]"
    />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <TrustBar
      items={[
        { icon: "wallet", text: "$75M Series B led by Index Ventures (2026)" },
        { icon: "spark", text: "Backed by Union Square Ventures, Benchmark" },
        { icon: "shield-check", text: "Non-custodial — you hold your own keys" },
        { icon: "chart", text: "SEC/CFTC guidance clarified in March 2026" },
      ]}
    />
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-16 sm:px-6">
    <h2 class="text-center text-2xl font-bold sm:text-3xl">Three steps to a lower fee</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-3">
      {
        steps.map((step, i) => (
          <Card class="text-center">
            <span class="mx-auto flex size-9 items-center justify-center rounded-full bg-[var(--color-accent)] text-sm font-bold text-[var(--color-bg)]">
              {i + 1}
            </span>
            <h3 class="mt-4 text-base font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{step.body}</p>
          </Card>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
    <h2 class="text-center text-2xl font-bold sm:text-3xl">See exactly what you'll save</h2>
    <div class="mt-8">
      <FeeCalculator
        orderValueLabel="Trade size (USD)"
        withoutCodeLabel={`Standard fee (${FOMO.spotFeePercent}%)`}
        withCodeLabel={`Your fee with code (${FOMO.feeDiscountPercent}% off)`}
        savingsLabel="You save"
        helpText="Spot trading fee shown. Perpetuals fees differ — see our fees breakdown."
      />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
    <h2 class="text-center text-2xl font-bold sm:text-3xl">Quick questions</h2>
    <div class="mt-8">
      <FAQAccordion items={faqItems} />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
    <RiskDisclaimer locale={locale} variant="page" />
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-20 text-center sm:px-6">
    <Card class="flex flex-col items-center gap-4">
      <h2 class="text-xl font-bold sm:text-2xl">Ready when you are</h2>
      <p class="text-sm text-[var(--color-muted)]">
        {SITE_NAME} — independent {FOMO.displayName} reviews and referral guides.
      </p>
      <Button href={FOMO.referralUrl} external size="lg" showArrow>
        Sign Up With {FOMO.feeDiscountPercent}% Off
      </Button>
    </Card>
  </section>
</BaseLayout>
