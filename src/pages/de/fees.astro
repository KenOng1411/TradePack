---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import Card from "../../components/Card.astro";
import FeeCalculator from "../../components/FeeCalculator.astro";
import RiskDisclaimer from "../../components/RiskDisclaimer.astro";
import { PAGE_KEYS, resolveLocaleUrl } from "../../i18n/routes";
import { FOMO } from "../../lib/site";

const locale = "de" as const;
const pageKey = PAGE_KEYS.fees;

const discountedFee = (FOMO.spotFeePercent * (1 - FOMO.feeDiscountPercent / 100)).toFixed(3);
---

<BaseLayout
  locale={locale}
  pageKey={pageKey}
  title="Fomo Gebühren im Überblick (2026): Spot, Perpetuals und Empfehlungscode-Rabatt"
  description="Klare Übersicht der tatsächlichen Fomo-Gebühren für Spot- und Perpetual-Handel sowie der realen Ersparnis durch den Empfehlungscode."
>
  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
    <h1 class="text-3xl font-extrabold sm:text-4xl">Fomo Gebühren im Überblick (2026)</h1>
    <p class="mt-4 max-w-2xl text-[var(--color-muted)]">
      Fomos Gebührenstruktur ist nicht auf einer einzigen Seite gebündelt — hier finden Sie die vollständige,
      aktuelle Übersicht (Stand 2026).
    </p>

    <div class="prose-content mt-10 max-w-none">
      <h2>Spothandelsgebühren</h2>
      <p>
        Vor Rabatt rund {FOMO.spotFeePercent}% pro Trade. Mit gültigem Empfehlungscode bei der Registrierung
        zusätzlich {FOMO.feeDiscountPercent}% Rabatt, effektiv also rund {discountedFee}%. Bei sehr kleinen Trades
        kann sich der tatsächliche Kostenanteil höher anfühlen, da meist eine Mindestgebühr pro Transaktion anfällt.
      </p>

      <h2>Perpetual-Futures-Gebühren (derzeit nicht für US-Nutzer verfügbar)</h2>
      <p>
        Perpetual Futures laufen über eine Integration mit {FOMO.perpsProvider}. Fomo berechnet zusätzlich zur
        Basisgebühr von {FOMO.perpsProvider} rund {FOMO.perpsFeePerSidePercent}% pro Seite — dadurch sind die
        direkten Kosten für Perpetuals über Fomo fast doppelt so hoch wie beim Spothandel.
      </p>
    </div>

    <div class="mt-12">
      <h2 class="text-xl font-bold sm:text-2xl">Gebührenrechner</h2>
      <p class="mt-2 text-sm text-[var(--color-muted)]">Geben Sie ein Handelsvolumen ein, um Standard- und Rabattgebühr zu vergleichen.</p>
      <div class="mt-6">
        <FeeCalculator
          orderValueLabel="Handelsvolumen (USD)"
          withoutCodeLabel={`Standardgebühr (${FOMO.spotFeePercent}%)`}
          withCodeLabel={`Gebühr mit Empfehlungscode (${FOMO.feeDiscountPercent}% Rabatt)`}
          savingsLabel="Ersparnis"
          helpText="Basierend auf Spothandelsgebühren. Für Perpetual Futures siehe Abschnitt oben."
        />
      </div>
    </div>

    <div class="prose-content mt-12 max-w-none">
      <h2>Weitere Kosten, die Sie kennen sollten</h2>
      <p>
        Da es sich um eine Non-Custodial-App handelt, fallen On-Chain-Netzwerkgebühren (Gas Fees) getrennt von den
        Fomo-Handelsgebühren an und variieren je nach Chain ({FOMO.chains.join(", ")}) und Netzwerkauslastung — diese
        Gebühr wird nicht von Fomo festgelegt und ist vom Empfehlungscode-Rabatt ausgenommen.
      </p>
    </div>

    <Card class="mt-12 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="font-semibold">Rabatt automatisch erhalten</p>
        <p class="mt-1 text-sm text-[var(--color-muted)]">Code {FOMO.referralCode} bei der Registrierung eingeben.</p>
      </div>
      <Button href={resolveLocaleUrl(locale, PAGE_KEYS.referralCode)} showArrow class="w-full sm:w-auto">
        Empfehlungscode ansehen
      </Button>
    </Card>

    <div class="mt-10">
      <RiskDisclaimer locale={locale} variant="page" />
    </div>
  </section>
</BaseLayout>

<style is:global>
  .prose-content h2 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .prose-content p {
    margin-bottom: 1.1rem;
    line-height: 1.75;
    color: var(--color-muted);
  }
</style>
