---
import type { GetStaticPaths } from "astro";
import BlogPostView from "../../../components/BlogPostView.astro";
import { getCollection } from "astro:content";

export const getStaticPaths = (async () => {
  const posts = await getCollection("blog", (e) => e.data.locale === "zh-hant");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^zh-hant\//, "") },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
---

<BlogPostView locale="zh-hant" post={post}>
  <Fragment slot="back-label">所有文章</Fragment>
</BlogPostView>
