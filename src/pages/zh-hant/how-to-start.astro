---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import Card from "../../components/Card.astro";
import Icon from "../../components/Icon.astro";
import RiskDisclaimer from "../../components/RiskDisclaimer.astro";
import AppScreenshot from "../../components/AppScreenshot.astro";
import { PAGE_KEYS, resolveLocaleUrl } from "../../i18n/routes";
import { FOMO } from "../../lib/site";
import depositModalScreenshot from "../../assets/screenshots/deposit-modal.jpg";
import mobileLoginScreenshot from "../../assets/screenshots/mobile-login.jpg";

const locale = "zh-hant" as const;
const pageKey = PAGE_KEYS.howToStart;

const steps = [
  {
    icon: "wallet" as const,
    title: "步驟一 —— 下載應用程式",
    body: `Fomo 支援 ${FOMO.platforms.join("、")}。請從官方應用程式商店或 fomo.family 直接下載 —— 避免使用第三方 APK 來源。`,
  },
  {
    icon: "shield-check" as const,
    title: "步驟二 —— 建立帳戶並備份復原方式",
    body: "註冊流程會在您的裝置上產生錢包。由於 Fomo 為非託管架構,您的錢包與金鑰是在裝置端產生並保護(採用 Shamir's Secret Sharing 技術),而非由 Fomo 儲存 —— 在存入任何資金前,務必完成應用程式提供的備份/復原設定。",
    screenshot: {
      src: mobileLoginScreenshot,
      alt: "Fomo 手機登入畫面,顯示「where traders become legends」文字與 Sign in with Apple、Sign in with Google 按鈕",
      caption: "Fomo 真實的登入畫面 —— 無需電子郵件或密碼,只需以 Apple 或 Google 登入。",
      narrow: true,
    },
  },
  {
    icon: "spark" as const,
    title: "步驟三 —— 輸入推薦碼",
    body: `註冊時輸入有效推薦碼,即可於日後所有交易享有 ${FOMO.feeDiscountPercent}% 手續費折扣。`,
  },
  {
    icon: "chart" as const,
    title: "步驟四 —— 存入資金",
    body: "依您所在地區與所用鏈支援的方式存入資金。Fomo 支援 Solana、Base、BNB Chain、Monad —— 存入前務必確認網路正確,選錯鏈是少數無法挽回的常見錯誤之一。",
    screenshot: {
      src: depositModalScreenshot,
      alt: "Fomo 的「Deposit with」彈窗顯示 Crypto(USDC)可用,Credit or debit 標示「Coming soon」",
      caption: "2026 年 9 月拍攝的 Fomo 存款畫面:加密貨幣(USDC)存款目前可用;信用卡存款仍標示「即將推出」——儘管 Fomo 行銷網站宣傳可用 Apple Pay 存款。",
    },
  },
  {
    icon: "check-circle" as const,
    title: "步驟五 —— 進行第一筆交易",
    body: `現貨交易(迷因幣、山寨幣、穩定幣)所有使用者皆可使用;永續合約(透過 ${FOMO.perpsProvider})於美國以外地區提供。若您是新手,建議先以熟悉的資產進行小額交易。`,
  },
  {
    icon: "shield-check" as const,
    title: "步驟六 —— 啟用安全功能",
    body: "在存入任何重要資金前,請啟用應用程式提供的所有安全選項(生物辨識、備份驗證等)。由於 Fomo 無法在裝置或金鑰出問題時代為介入,您自身的安全設定比在中心化交易所上扮演更重要的角色。",
  },
];
---

<BaseLayout
  locale={locale}
  pageKey={pageKey}
  title="Fomo 新手上路:逐步教學"
  description="從安裝 Fomo、輸入推薦碼到完成第一筆交易的完整教學。"
>
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <h1 class="text-3xl font-extrabold sm:text-4xl">Fomo 新手上路</h1>
    <p class="mt-4 text-[var(--color-muted)]">
      從安裝到第一筆享有折扣的交易,共六個步驟。無需帳號,無需密碼 —— 只需要錢包與推薦碼。
    </p>

    <ol class="mt-10 flex flex-col gap-5">
      {
        steps.map((step) => (
          <li>
            <Card>
              <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
                <span class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-[var(--color-accent-soft)] text-[var(--color-accent)]">
                  <Icon name={step.icon} class="size-7" />
                </span>
                <div>
                  <h2 class="text-base font-semibold sm:text-lg">{step.title}</h2>
                  <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)] sm:text-base">{step.body}</p>
                </div>
              </div>
              {step.screenshot && (
                <div class:list={["mt-5", step.screenshot.narrow && "max-w-[220px]"]}>
                  <AppScreenshot src={step.screenshot.src} alt={step.screenshot.alt} caption={step.screenshot.caption} />
                </div>
              )}
            </Card>
          </li>
        ))
      }
    </ol>

    <Card class="mt-10 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="font-semibold">推薦碼準備好了嗎?</p>
        <p class="mt-1 text-sm text-[var(--color-muted)]">使用代碼 {FOMO.referralCode} 享 {FOMO.feeDiscountPercent}% 手續費折扣。</p>
      </div>
      <Button href={resolveLocaleUrl(locale, PAGE_KEYS.referralCode)} showArrow class="w-full sm:w-auto">
        查看推薦碼
      </Button>
    </Card>

    <div class="mt-10">
      <RiskDisclaimer locale={locale} variant="page" />
    </div>
  </section>
</BaseLayout>
